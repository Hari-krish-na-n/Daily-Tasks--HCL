<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================
         Project Identity
         ===================================================== -->
    <groupId>com.auction</groupId>
    <artifactId>online-auction-training</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Online Auction System - Training</name>
    <description>
        Beginner-friendly Java 21 Maven console application for
        HCL Day 1 and Day 2 training tasks. Covers Java Platform
        Basics, Language Fundamentals, and Agile/Scrum concepts
        using the Online Auction System domain.
    </description>

    <!-- =====================================================
         Java 21 Properties
         ===================================================== -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>com.auction.PlatformInfo</exec.mainClass>
    </properties>

    <!-- =====================================================
         No external dependencies — plain Java only
         ===================================================== -->
    <dependencies>
        <!-- No Spring, no Hibernate, no database drivers -->
        <!-- This is a plain Java 21 training project     -->
    </dependencies>

    <!-- =====================================================
         Build Configuration
         ===================================================== -->
    <build>
        <plugins>

            <!-- Compiler plugin: enforce Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Exec plugin: run console classes with mvn exec:java -->
            <!--
                Usage examples:
                  mvn exec:java -Dexec.mainClass="com.auction.PlatformInfo"
                  mvn exec:java -Dexec.mainClass="com.auction.AuctionDataDemo"
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- Default main class; override with -Dexec.mainClass="..." -->
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
